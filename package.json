{
  "name": "digipm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "dotenv -e .env -- pnpm --filter @digipm/web dev",
    "build": "pnpm --filter @digipm/web build",
    "start": "dotenv -e .env -- pnpm --filter @digipm/web start",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.verification.json",
    "test": "dotenv -e .env -- vitest run",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- node packages/db/migrate.mjs",
    "db:seed": "dotenv -e .env -- tsx scripts/seed.ts",
    "format": "prettier --write apps packages scripts tests *.json *.yaml",
    "format:check": "prettier --check apps packages scripts tests *.json *.yaml",
    "backup": "dotenv -e .env -- tsx scripts/backup.ts",
    "backup:verify": "dotenv -e .env -- tsx scripts/verify-restore.ts",
    "smoke:http": "tsx scripts/smoke-http.ts",
    "smoke:auth": "tsx scripts/smoke-auth.ts",
    "benchmark": "dotenv -e .env -- tsx scripts/benchmark.ts"
  },
  "devDependencies": {
    "@orpc/client": "1.15.0",
    "@orpc/server": "1.15.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "dotenv-cli": "11.0.0",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "20.14.0",
    "idb-keyval": "6.2.2",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=24 <26"
  }
}
