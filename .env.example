POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://digipm:replace-with-a-random-password@localhost:55438/digipm
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=11025
SMTP_FROM=DigiPM <hello@digipm.local>
ASSET_DIR=.data/assets

# Codex personnel : stockage privé côté serveur. Le binaire 0.153.4 est installé par pnpm.
CODEX_DATA_DIR=.data/codex
# CODEX_BIN=/chemin/vers/codex

# Pack privé : pnpm pm-os:import /chemin/vers/PM-OS (révision 3076943)
PM_OS_DATA_DIR=.data/pm-os
PM_OS_RUN_TIMEOUT_MS=1800000
# Worker privé ; ce secret reste côté serveur et worker, jamais dans le navigateur.
PM_WORKER_URL=http://127.0.0.1:8090
PM_WORKER_TOKEN=replace-with-at-least-32-random-characters
PM_WORKER_DATA_DIR=.data/pm-worker
PM_RUNNER_IMAGE=digipm-pm-runner:1
