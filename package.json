{
  "name": "digipm",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.10",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "dev:db": "drizzle-kit studio",
    "build": "vite build",
    "start": "bun .output/server/index.mjs",
    "checks": "biome check . && tsc --noEmit",
    "fix": "biome check --write .",
    "test": "bun --no-env-file scripts/testing/run-tests.ts",
    "verify:baseline": "bun run checks && bun run build && bun run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun scripts/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/db/seed.ts",
    "db:start": "docker compose up -d",
    "db:stop": "docker compose down",
    "generate:auth": "bunx @better-auth/cli generate --output ./db/schema/auth/schema.ts && biome check --write ./db/schema/auth/schema.ts",
    "backup:create": "bun scripts/backup/create-backup.ts",
    "backup:verify": "bun scripts/backup/verify-restore.ts",
    "smoke:http": "bun scripts/smoke/http.ts",
    "smoke:auth": "bun scripts/smoke/auth.ts",
    "bench:database": "bun scripts/benchmarks/database-query.ts",
    "build:migrate": "bun build scripts/db/migrate.ts --target=bun --outfile=.output/migrate.mjs",
    "test:guard": "bun --no-env-file scripts/testing/assert-safe-test-environment.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.44",
    "@better-auth/drizzle-adapter": "1.7.3",
    "@dnd-kit/helpers": "0.5.0",
