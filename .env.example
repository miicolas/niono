POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://digipm:replace-with-a-random-password@localhost:55438/digipm
# Taille du pool de connexions (1-50)
DATABASE_POOL_MAX=10
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
# Resend : sans clé, les emails sont écrits dans EMAIL_OUTBOX_DIR (développement uniquement)
RESEND_API_KEY=
EMAIL_FROM=DigiPM <hello@digipm.local>
EMAIL_OUTBOX_DIR=.data/outbox
# Chemin absolu recommandé
ASSET_DIR=.data/assets
# Assistant IA (optionnel) : AI_MODEL + AI_GATEWAY_API_KEY, ou AI_BASE_URL (+ AI_API_KEY)
AI_MODEL=
AI_GATEWAY_API_KEY=
AI_BASE_URL=
AI_API_KEY=
# Journal JSON des requêtes RPC (true/false)
LOG_REQUESTS=
